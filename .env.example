# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# Gemini key (server-only, never exposed to the browser).
# Get a FREE Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Express server port.
PORT=5000

# Environment: "development" or "production".
NODE_ENV=development

# Comma-separated list of origins allowed to call /api/chat.
# In dev this matches Vite's default. In prod, set this to your real frontend URL
# (e.g. https://kwes.org,https://www.kwes.org).
ALLOWED_ORIGIN=http://localhost:5173

# Protects /api/payments/audit. REQUIRED in production.
ADMIN_KEY=replace-with-a-long-random-secret

# M-Pesa Daraja settings (required for automatic STK push mode).
# Use "sandbox" during testing and "production" for live payments.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Public HTTPS endpoint Daraja calls after customer approves/declines STK push.
# Example (deployed): https://api.yourdomain.com/api/payments/mpesa/callback
# Example with callback secret: https://api.yourdomain.com/api/payments/mpesa/callback?token=your-callback-secret
# Example (temporary tunnel): https://xxxx-xx-xx-xx-xx.ngrok-free.app/api/payments/mpesa/callback?token=your-callback-secret
MPESA_CALLBACK_URL=

# Optional: protects callback endpoint with a shared secret in query string.
MPESA_CALLBACK_SECRET=

# Manual fallback recipient shown when Daraja is not configured.
MPESA_RECEIVER_MSISDN=+254140401128

# NOTE:
# If you do not have M-Pesa credentials, leave MPESA_* credentials empty.
# The backend will automatically use manual payment mode.
